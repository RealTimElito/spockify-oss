# Spockify environment — copy to .env and edit. NEVER commit your .env.
#
# Generate strong secrets, e.g.:
#   openssl rand -base64 24     # POSTGRES_PASSWORD
#   openssl rand -hex 32        # WEBUI_SECRET_KEY
#   printf 'sk-%s' "$(openssl rand -hex 24)"   # LITELLM_MASTER_KEY

# --- Secrets (change all of these) ---
POSTGRES_PASSWORD=change-me-postgres
LITELLM_MASTER_KEY=sk-change-me
WEBUI_SECRET_KEY=change-me-32-chars-minimum

# --- Storage ---
# Where Postgres / Ollama / OpenWebUI data is persisted on the host.
STORAGE_ROOT=./data/spockify

# --- Web UI ---
# Public URL users hit. Keep http://localhost:3000 for local use.
WEBUI_URL=http://localhost:3000
# Set to "true" ONCE on first boot to register the first admin, then set back to "false".
ENABLE_SIGNUP=false

# --- Images (optional) ---
# Leave unset to build the router locally from ./services/router.
# To pull a published image instead, set e.g.:
#   SPOCKIFY_ROUTER_IMAGE=ghcr.io/OWNER/spockify-router:latest
# SPOCKIFY_ROUTER_IMAGE=spockify-router:local
#
# To run the Spockify OpenWebUI fork instead of stock upstream, build it
# (docker compose -f docker-compose.yml -f docker-compose.fork.yml build openwebui)
# or point at a published image:
#   SPOCKIFY_OPENWEBUI_IMAGE=ghcr.io/OWNER/spockify-openwebui:latest
