# Copy to .env and change the secrets before exposing this stack on a network.
#   cp .env.example .env

POSTGRES_PASSWORD=spockify-dev
LITELLM_MASTER_KEY=sk-spockify-change-me
# Must be >= 32 characters (Open WebUI session signing).
WEBUI_SECRET_KEY=change-me-to-at-least-32-characters
SEARXNG_SECRET=change-me-searxng-secret

# Host ports
SPOCKIFY_CHAT_PORT=3080
SPOCKIFY_API_PORT=4000
SPOCKIFY_ROUTER_PORT=4100

# URL browsers use to reach chat. Leave empty for LAN/IP access (derived from the
# request). Set explicitly for OAuth redirects / share links, e.g.:
#   WEBUI_URL=http://chat.example:3080
# WEBUI_URL=

# Air-gap defaults (compose). First image/model pull needs network; after that
# chat UI + local Ollama work offline. SearXNG/web search degrade with no WAN.
# OFFLINE_MODE=true
# Optional neural TTS when online: AUDIO_TTS_ENGINE=edge

# Bind-mount root for ollama/openwebui (:z in compose). Docker also binds
# postgres here. Podman/run.sh uses named volume spockify_pgdata instead.
STORAGE_ROOT=./data/spockify

# Config paths — git clone defaults. The GitHub/spockify.eu zip overrides these.
LITELLM_CONFIG=./docker/litellm.yaml
SEARXNG_CONFIG=./docker/searxng-settings.yml
ROUTING_RULES=./docker/routing-rules.json
ORCHESTRATOR_PROMPT=./config/orchestrator-prompt.md
POSTGRES_INIT=./docker/postgres-init
# Optional: make demo / make demo-gpu (authorized defensive overlay — not unfiltered)
# DEMO_SYSTEM_PROMPT=./docker/security-demo-prompt.md
# SPOCKIFY_DEMO_PROFILE=security

# First account created in the UI is admin. Set to false after that.
ENABLE_SIGNUP=true

# Prebuilt images. ./docker/run.sh pulls GHCR from `git remote` when unset
# (avoids a local Open WebUI npm build). Uncomment to pin.
# SPOCKIFY_ROUTER_IMAGE=ghcr.io/OWNER/spockify-router:latest
# SPOCKIFY_OPENWEBUI_IMAGE=ghcr.io/OWNER/spockify-openwebui:latest
# SPOCKIFY_IMAGE_TAG=latest

# Space-separated Ollama tags pulled on first start (~20 GiB lean default).
# Fits 8–12 GiB VRAM: 3b orchestrator + 8b chat + codestral (Tab FIM).
# Smoke: OLLAMA_PULL_MODELS=llama3.2:3b
# 12GB+ quality chat:
#   OLLAMA_PULL_MODELS=llama3.2:3b llama3.1:8b codestral gemma4:12b
#   DEFAULT_CHAT_WORKER=gemma4-12b
# 16GB+ agentic: append devstral-small-2.
# Huge (~75GB): append devstral-2 only on Spark/121GiB-class hosts (not default).
OLLAMA_PULL_MODELS=llama3.2:3b llama3.1:8b codestral
# Compose defaults: FAST_CHAT_WORKER / ORCHESTRATOR_MODEL = llama3.2-3b-cpu (VRAM-free).
# DEFAULT_CHAT_WORKER=llama3.1-8b
# FAST_CHAT_WORKER=llama3.2-3b-cpu
# ORCHESTRATOR_MODEL=llama3.2-3b-cpu
# DEFAULT_MODELS=spockify-auto
#
# Custom Ollama tag you pulled yourself (see docker/README.md → Custom Ollama):
#   1) podman/docker exec … ollama pull <exact-ollama-tag>
#   2) add model_name + ollama_chat/<exact-ollama-tag> in docker/litellm.yaml
#   3) uncomment and set, then: make down && make gpu
# DEFAULT_MODELS=my-custom
# DEFAULT_CHAT_WORKER=my-custom
# FAST_CHAT_WORKER=my-custom
# ORCHESTRATOR_MODEL=my-custom

# GPU: make gpu  /  ./docker/run.sh --gpu
# (Docker: gpus=all; Fedora Podman: /dev/nvidia* unless CDI verifies + nvidia-smi check)
