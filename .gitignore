# =============================================================================
# Spockify / agentHub — root .gitignore
# Keep secrets, build artifacts, vendor blobs, and large binaries out of git
# before `git init` / first push.
# =============================================================================

# --- Secrets & local env ------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
*.crt
!**/certs/.gitkeep
**/id_rsa*
**/id_ed25519*
*_rsa
*_ed25519
credentials.json
service-account*.json
k8s/secrets.yaml
k8s/**/secrets.yaml
k8s/**/*secret*.yaml
!k8s/**/*secret*.example.yaml
!k8s/**/*.example
config/spark.env
config/*.local.env
config/local.env
.deploy-state/

# --- Editor / OS junk ---------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
*.code-workspace

# --- Python -------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
dist/
*.egg

# --- Node / JS ----------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.yarn/
.pnpm-store/
*.tsbuildinfo
.turbo/
.next/
.nuxt/
coverage/

# --- OpenWebUI branding (local overlays) --------------------------------------
services/openwebui/branding/*
!services/openwebui/branding/.gitkeep
!services/openwebui/branding/.gitignore

# --- LiteLLM local config overrides -------------------------------------------
k8s/litellm/config/*
!k8s/litellm/config/.gitkeep

# --- Spockify Desktop IDE — fetched upstreams / vendor blobs ------------------
apps/spockify-ide/vendor/code-oss/
apps/spockify-ide/vendor/VSCode-linux-*/
apps/spockify-ide/vendor/VSCode-darwin-*/
apps/spockify-ide/vendor/VSCode-win32-*/
apps/spockify-ide/vendor/vscode-reh-*/
apps/spockify-ide/VSCode-linux-*/
apps/spockify-ide/VSCode-darwin-*/
apps/spockify-ide/VSCode-win32-*/
extensions/spockify-remote-ssh/upstream/

# --- Spockify IDE build / package artifacts -----------------------------------
apps/spockify-ide/build/
!apps/spockify-ide/build/.gitkeep
*.AppImage
*.AppImage.zsync
*.deb
*.dmg
*.exe
*.msi
*.AppDir/
**/Spockify-IDE-*.zip
**/Spockify-IDE_*.deb
**/SHA256SUMS
!**/docs/**/SHA256SUMS

# --- Large / binary blobs (models, images, ML checkpoints) --------------------
*.gguf
*.safetensors
*.ckpt
*.pt
*.pth
*.onnx
*.bin
!**/package-lock.json
!**/yarn.lock
!**/pnpm-lock.yaml
# Only repo-root weight blobs. Do NOT ignore **/models/ — that hid
# Open WebUI SQLAlchemy/API/workspace packages from git (same lesson as
# checkpoints/ below).
/models/
# Do NOT ignore directories named checkpoints/ — that hid
# extensions/spockify/src/checkpoints/ from git and broke CI compile.
# Durable IDE snapshots live under .spockify/checkpoints/ (covered below).
*.iso
*.img
*.qcow2
*.vdi
*.vmdk

# --- Local durable IDE / agent state ------------------------------------------
.spockify/
**/.spockify/
.cursor/
!.cursor/rules/
!.cursor/skills/
agent-transcripts/

# --- Logs & temp --------------------------------------------------------------
*.log
logs/
tmp/
temp/
.tmp/
.cache/

# --- OSS docker kit (local data + packed releases) ----------------------------
/data/
/dist/
docker/ide/payload/*.AppImage


# --- Tab train local artifacts (synth/distill JSONL, adapters) ---------------
services/tab-train/data/
