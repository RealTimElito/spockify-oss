{
  "name": "@spockify/cli",
  "version": "0.1.0",
  "description": "Claude Code\u2013style Spockify CLI (device login + agent tools)",
  "license": "MIT",
  "bin": {
    "spockify": "./dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "dev": "tsx src/index.ts",
