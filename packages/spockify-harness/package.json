{
  "name": "@spockify/harness",
  "version": "0.1.0",
  "description": "Shared Spockify coding-agent kernel (CLI / IDE / lab)",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
