    "foreground": "#0c1824",
    "descriptionForeground": "#4a5d73",
    "errorForeground": "#c0392b",
    "warningForeground": "#b45a1a",
    "selection.background": "#1aa89c33",
    "widget.border": "#1aa89c33",

    "editor.background": "#f4f8fb",
