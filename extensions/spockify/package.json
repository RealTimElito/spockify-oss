{
  "name": "spockify",
  "displayName": "Spockify",
  "description": "Open-source Cursor alternative — chat, tab complete, Ctrl+K, composer, agents, terminal agent via spockify.eu",
  "version": "0.9.14",
  "publisher": "spockify",
  "license": "MIT",
  "icon": "media/spockify-icon.png",
  "enabledApiProposals": [
    "terminalSelection",
    "terminalDataWriteEvent"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "ui"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Spockify Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/spockify-dark-color-theme.json"
      },
      {
        "label": "Spockify Light",
        "uiTheme": "vs",
        "path": "./themes/spockify-light-color-theme.json"
      }
    ],
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "spockify",
          "title": "Chat",
          "icon": "media/spockify-activity.svg"
        },
        {
          "id": "spockify-composer",
          "title": "Composer",
          "icon": "$(edit)"
        },
        {
          "id": "spockify-agents",
          "title": "Agents",
          "icon": "$(organization)"
        },
        {
          "id": "spockify-terminal",
          "title": "Terminal Agent",
          "icon": "$(terminal)"
        }
      ]
    },
    "views": {
      "spockify": [
        {
          "type": "webview",
          "id": "spockify.chatView",
          "name": "Chat",
          "contextualTitle": "Spockify Chat",
          "visibility": "visible"
        }
      ],
      "spockify-composer": [
        {
          "type": "webview",
          "id": "spockify.composerPanel",
          "name": "Composer",
          "contextualTitle": "Spockify Composer",
          "visibility": "visible"
        },
        {
          "id": "spockify.composerView",
          "name": "Pending",
          "contextualTitle": "Composer Pending",
          "visibility": "visible"
        }
      ],
      "spockify-agents": [
        {
          "id": "spockify.agents",
          "name": "Agents",
          "contextualTitle": "Spockify Agents",
          "visibility": "visible"
        }
      ],
      "spockify-terminal": [
        {
          "id": "spockify.terminalSessions",
          "name": "Sessions",
          "contextualTitle": "Terminal Agent Sessions",
          "visibility": "visible"
        }
      ]
    },
